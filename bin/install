#!/usr/bin/env bash

set -euo pipefail

current_script_path="${BASH_SOURCE[0]}"
plugin_dir="$(dirname "$(dirname "${current_script_path}")")"

# shellcheck source=../lib/utils.bash
source "${plugin_dir}/lib/utils.bash"

if [ "${ASDF_INSTALL_TYPE}" != "version" ]; then
	log_failure_and_exit "Please provide the oci version number you wish to install. See \`asdf list all oci\`."
fi

: "${ASDF_INSTALL_PATH:?}"

check_dependencies "${plugin_dir}/lib/dependencies.txt" "failure"

if ! command -v python3 >/dev/null 2>&1; then
	log_failure_and_exit "python3 is required to install oci."
fi

# Virtual environment scripts contain absolute paths, so do not relocate the venv.
mkdir -p "${ASDF_INSTALL_PATH}"
cleanup() {
	rm -rf "${ASDF_INSTALL_PATH}"
}
trap cleanup EXIT

log_info "🚧  installing oci ${ASDF_INSTALL_VERSION}..."

install_dir="${ASDF_INSTALL_PATH}/venv"
exec_dir="${ASDF_INSTALL_PATH}/bin"

mkdir -p "${exec_dir}"

python3 -m venv "${install_dir}"

pip_bin="${install_dir}/bin/pip"

declare -a pip_args
pip_args=(--disable-pip-version-check)

if [ -n "${ASDF_DOWNLOAD_PATH:-}" ] && [ -d "${ASDF_DOWNLOAD_PATH}" ] && find "${ASDF_DOWNLOAD_PATH}" -mindepth 1 -print -quit >/dev/null 2>&1; then
	log_info "📦  Installing from cached artifacts in ${ASDF_DOWNLOAD_PATH}."
	pip_args+=(--no-index --find-links "${ASDF_DOWNLOAD_PATH}")
else
	"${pip_bin}" --disable-pip-version-check install --upgrade pip >/dev/null
	log_info "ℹ️  Installing via PyPI; run bin/download to prefetch artifacts for offline use."
fi

pip_args+=("oci-cli==${ASDF_INSTALL_VERSION}")

"${pip_bin}" install "${pip_args[@]}"

ln -sf "../venv/bin/oci" "${exec_dir}/oci"

trap - EXIT

log_success "oci ${ASDF_INSTALL_VERSION} installed!"
