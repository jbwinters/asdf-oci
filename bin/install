#!/usr/bin/env bash

set -euo pipefail

current_script_path="${BASH_SOURCE[0]}"
plugin_dir="$(dirname "$(dirname "$current_script_path")")"

# shellcheck source=../lib/utils.bash
source "${plugin_dir}/lib/utils.bash"

install_oci() {
	log_info "🚧  installing oci ${ASDF_INSTALL_VERSION}..."

	local tmp_dir
	tmp_dir="$(mktemp -d)"
	cleanup() {
		rm -rf "${tmp_dir}"
	}
	trap cleanup EXIT

	local install_script="${tmp_dir}/install.sh"
	curl -fsSL https://raw.githubusercontent.com/oracle/oci-cli/master/scripts/install/install.sh -o "${install_script}" || \
		log_failure_and_exit "Failed to download official OCI CLI installer script"

	local install_dir="${ASDF_INSTALL_PATH}/venv"
	local exec_dir="${ASDF_INSTALL_PATH}/bin"
	local script_dir="${ASDF_INSTALL_PATH}/scripts"

	rm -rf "${install_dir}"
	mkdir -p "${install_dir}" "${exec_dir}" "${script_dir}"

	bash "${install_script}" \
		--oci-cli-version "${ASDF_INSTALL_VERSION}" \
		--accept-all-defaults \
		--no-tty \
		--install-dir "${install_dir}" \
		--exec-dir "${exec_dir}" \
		--script-dir "${script_dir}"

	trap - EXIT
	cleanup

	# test executable
	test -x "${exec_dir}/oci" || log_failure_and_exit "Expected ${exec_dir}/oci to be executable."
	log_success "oci ${ASDF_INSTALL_VERSION} installed!"

}

if [ "${ASDF_INSTALL_TYPE}" != "version" ]; then
	log_failure_and_exit "Please provide the oci version number you wish to install. See \`asdf list all oci\`"
fi

install_oci

# reshim now sdk components are installed
asdf reshim "$(get_plugin_name)" "$ASDF_INSTALL_VERSION"
